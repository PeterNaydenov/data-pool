{
  "name": "@peter.naydenov/data-pool",
  "version": "2.2.1",
  "description": "Data-pool is a data-layer for node apps and single page application",
  "main": "./src/main.js",
  "module": "./dist/data-pool.esm.mjs",
  "browser": "./dist/data-pool.umd.js",
  "types": "./types/main.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/data-pool.esm.mjs",
      "require": "./dist/data-pool.cjs",
      "browser": "./dist/data-pool.umd.js",
      "types": "./types/main.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build": "rollup -c && npm run build:types",
    "build:types": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/data-pool.git"
  },
  "author": "Peter Naydenov",
  "license": "MIT",
  "keywords": [
    "data",
    "cache",
    "store"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "rollup": "^4.62.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@peter.naydenov/notice": "^2.5.0",
    "@peter.naydenov/signals": "^1.3.1",
    "@peter.naydenov/walk": "^6.0.0",
    "ask-for-promise": "^3.2.0"
  },
  "overrides": {
    "diff": "^5.2.0",
    "serialize-javascript": "^7.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
